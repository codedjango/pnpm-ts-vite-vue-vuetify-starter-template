{
	"name": "pnpm-ts-vite-vue-vuetify-starter",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"lint": "oxlint --fix",
		"typecheck": "vue-tsc --build --force",
		"fmt": "oxfmt --write .",
		"format": "pnpm typecheck && pnpm lint && pnpm fmt"
	},
	"dependencies": {
		"@fontsource/roboto": "^5.3.0",
		"@mdi/font": "^7.4.47",
		"@vueuse/core": "^14.4.0",
		"pinia": "^4.0.3",
		"vue": "^3.5.42",
		"vue-router": "^5.3.0",
		"vuetify": "^4.2.0"
	},
	"devDependencies": {
		"@types/node": "^26.4.1",
		"@types/web": "^0.0.354",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vue/tsconfig": "^0.9.1",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"typescript": "~6.0.3",
		"unplugin-fonts": "^2.0.0",
		"vite": "^8.2.2",
		"vite-plugin-vue-devtools": "^8.2.1",
		"vite-plugin-vuetify": "^2.1.3",
		"vue-tsc": "^3.3.11"
	}
}
